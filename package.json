{
  "name": "kith-space",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/dist/main.cjs",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Desktop-first personal AgentOS where one human collaborates with persistent local AI agents across spaces, channels, tasks, and memory.",
  "license": "Apache-2.0",
  "author": "CKang-J",
  "homepage": "https://github.com/CKang-J/Kith-space#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/CKang-J/Kith-space.git"
  },
  "bugs": {
    "url": "https://github.com/CKang-J/Kith-space/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "workspace",
    "collaboration",
    "local-first",
    "desktop",
    "claude",
    "open-source"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/db/seed.ts",
    "seed:dev": "tsx src/db/seed-dev.ts",
    "server": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "web:build": "pnpm --dir web run build",
    "canvas:stage1:materialize": "node scripts/audit-recombyn-stage1-closure.mjs && node scripts/materialize-recombyn-stage1-native.mjs && node scripts/build-recombyn-stage1-css.mjs",
    "canvas:stage1:build": "node scripts/build-recombyn-stage1-harness.mjs",
    "stop": "node scripts/stop-dev.mjs",
    "daemon": "tsx src/daemon/index.ts",
    "cli": "tsx src/cli/index.ts",
    "browser-access:dev": "tsx src/dev/browserAccess.ts",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:bundle": "pnpm run web:build && node scripts/build-desktop.mjs --production",
    "desktop:pack": "node scripts/package-desktop.mjs --dir",
    "desktop:dist": "node scripts/package-desktop.mjs --nsis",
    "desktop:dev": "pnpm run desktop:build && node scripts/desktop-dev.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "wt:add": "node scripts/wt-add.mjs",
    "wt:rm": "node scripts/wt-rm.mjs",
    "dev:e2e:up": "node scripts/dev-e2e-up.mjs",
    "dev:e2e:down": "node scripts/dev-e2e-down.mjs"
  },
  "build": {
    "appId": "space.kith.desktop",
    "productName": "Kith-space",
    "artifactName": "Kith-space-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/dist/main.cjs",
      "desktop/dist/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/dist/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "drizzle",
        "to": "drizzle",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/canvas/skills/foundation",
        "to": "canvas-skills/foundation",
        "filter": [
          "**/*.md"
        ]
      },
      {
        "from": "src/canvas/skills/domains",
        "to": "canvas-skills/domains",
        "filter": [
          "**/*.md"
        ]
      },
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_LICENSES.md"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "web/public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.11.1",
    "busboy": "^1.6.0",
    "commander": "^12.1.0",
    "cross-spawn": "7.0.6",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.3",
    "undici": "7.29.0",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.31.10",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  }
}
