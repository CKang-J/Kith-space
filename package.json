{
  "name": "kith-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "description": "Desktop-first, local-first workspace where people collaborate with a team of persistent AI agents across channels, tasks, and memory.",
  "license": "Apache-2.0",
  "author": "fancyboi999",
  "homepage": "https://github.com/fancyboi999/kith-space#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fancyboi999/kith-space.git"
  },
  "bugs": {
    "url": "https://github.com/fancyboi999/kith-space/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "workspace",
    "collaboration",
    "self-hosted",
    "slack",
    "claude",
    "open-source"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/db/seed.ts",
    "seed:dev": "tsx src/db/seed-dev.ts",
    "server": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "web:build": "pnpm --dir web run build",
    "docs:build": "pnpm --dir docs-site run build",
    "site:build": "pnpm run web:build && pnpm run docs:build",
    "stop": "pkill -f 'src/server/index.ts'; pkill -f 'src/daemon/index.ts'; pkill -f 'bin/vite'; true",
    "start:prod": "ENV_FILE=.env.prod tsx src/server/index.ts",
    "daemon:prod": "set -a && . ./.env.prod && set +a && ENV_FILE=.env.prod tsx src/daemon/index.ts --api-key \"$DAEMON_BOOTSTRAP_KEY\"",
    "seed:prod": "ENV_FILE=.env.prod tsx src/db/seed.ts",
    "stop:prod": "lsof -ti tcp:7788 -sTCP:LISTEN | xargs kill 2>/dev/null; true",
    "prod:up": "bash scripts/prod-up.sh",
    "prod:down": "bash scripts/prod-down.sh",
    "daemon": "tsx src/daemon/index.ts --api-key poc-secret-key",
    "cli": "tsx src/cli/index.ts",
    "pkg:daemon:build": "node scripts/build-daemon-pkg.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "wt:add": "bash scripts/wt-add.sh",
    "wt:rm": "bash scripts/wt-rm.sh",
    "dev:e2e:up": "bash scripts/dev-e2e-up.sh",
    "dev:e2e:down": "bash scripts/dev-e2e-down.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "busboy": "^1.6.0",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.3",
    "ws": "^8.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.5",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1078.0"
  }
}
