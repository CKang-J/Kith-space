{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@kith-canvas-fonts": ["../src/canvas/fonts/fontsCatalog.ts"],
      "@recombyn-native/utils/uploadImage": ["./src/features/canvas/adapters/recombynDurableMedia.ts"],
      "@recombyn-native/*": ["./src/features/canvas/upstream/apps/web/src/*"],
      "@recombyn-canvas-plugins/*": ["./src/features/canvas/upstream/plugins/canvas/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
