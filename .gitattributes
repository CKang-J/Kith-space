# Shell scripts MUST use LF — bash (incl. Git Bash on Windows) fails to parse
# CRLF-terminated scripts ("set: pipefail: invalid option name" etc.).
# Without this, core.autocrlf can rewrite them to CRLF on checkout and break dev.
*.sh text eol=lf
*.bash text eol=lf

# Drizzle journals the migration file bytes, so line endings are part of the immutable hash.
drizzle/*.sql text eol=lf

# Keep other line endings as-is; Node/TS/JSON/MD tolerate CRLF.
