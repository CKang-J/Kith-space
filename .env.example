# Transitional split-process development only.
# Space data lives under each Space root; installation data lives in $KITH_SPACE_HOME/app.db.
PORT=7777

# Required until Electron owns the Core Service and Worker process group.
# Generate two independent values, for example with: openssl rand -hex 32
# Electron will generate fresh credentials per launch in A4.
KITH_SPACE_DESKTOP_TOKEN=
KITH_SPACE_WORKER_TOKEN=

# Optional installation-data override. Default: ~/.kith-space
# KITH_SPACE_HOME=~/.kith-space

# Browser mode, port, Access Token hash, and sessions are stored in app.db, not .env.
# For split-process development, use `pnpm run browser-access:dev`.
# Attachments always live at <spaceRoot>/.kith/uploads.
